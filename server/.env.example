# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/contextswap

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AI Classification (optional — falls back to a built-in keyword classifier if unset)
# Provide ONE of these. If both are set, GROK is tried first, then GEMINI, then the fallback.
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-2-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
